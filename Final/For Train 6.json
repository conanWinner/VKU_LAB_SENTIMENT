    {
      "parameters": {
        "jsCode": "const rawOutput = $input.item.json.output;\nlet augmentedArray;\n\ntry {\n  // Strip markdown code fences if present\n  const cleaned = rawOutput.replace(/```json|```/g, '').trim();\n  augmentedArray = JSON.parse(cleaned);\n} catch(e) {\n  // Fallback: extract array from string\n  const match = rawOutput.match(/\\[.*\\]/s);\n  if (match) {\n    augmentedArray = JSON.parse(match[0]);\n  } else {\n    throw new Error('Cannot parse LLM output: ' + rawOutput);\n  }\n}\n\nreturn [{\n  json: {\n    augmented_sentences: augmentedArray\n  }\n}];"
      },
