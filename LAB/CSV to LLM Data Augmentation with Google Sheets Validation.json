    {
      "parameters": {
        "jsCode": "const originalData = {\n  Sentence: $input.item.json.Sentence || $('Loop Over Items2').item.json.Sentence,\n  'Aspect Term': $input.item.json['Aspect Term'] || $('Loop Over Items2').item.json['Aspect Term'],\n  polarity: $input.item.json.polarity || $('Loop Over Items2').item.json.polarity\n};\n\nconst rawOutput = $input.item.json.output;\nlet augmentedArray;\n\ntry {\n  // Strip markdown code fences if present\n  const cleaned = rawOutput.replace(/```json|```/g, '').trim();\n  augmentedArray = JSON.parse(cleaned);\n} catch(e) {\n  // Fallback: extract array from string\n  const match = rawOutput.match(/\\[.*\\]/s);\n  if (match) {\n    augmentedArray = JSON.parse(match[0]);\n  } else {\n    throw new Error('Cannot parse LLM output: ' + rawOutput);\n  }\n}\n\nreturn [{\n  json: {\n    ...originalData,\n    augmented_sentences: augmentedArray\n  }\n}];"
      },
