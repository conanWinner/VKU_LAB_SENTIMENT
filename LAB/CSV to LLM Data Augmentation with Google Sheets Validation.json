    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.Sentence }}",
        "options": {
          "systemMessage": "=You are an expert in Aspect-Based Sentiment Analysis (ABSA) dataset augmentation.\n\nYour task is to generate paraphrased versions of a sentence while preserving the sentiment toward a specific aspect term.\n\nRules:\n- The aspect term must remain exactly the same word.\n- The sentiment toward the aspect must remain unchanged.\n- Do not remove the aspect term.\n- Do not introduce new conflicting opinions.\n- Only rephrase wording or structure.\n\nSentence:{{ $json.Sentence }}\nAspect Term:{{ $json['Aspect Term'] }}\nSentiment:{{ $json.polarity }}\n\nGenerate exactly 3 paraphrased sentences.\n\nReturn ONLY a JSON array like this:\n[\"sentence1\", \"sentence2\", \"sentence3\"] "
        }
      },
      "id": "61879b63-ba70-474e-b2b6-988f35ad1170",
